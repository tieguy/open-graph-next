# Local secrets for this working copy. Ignored by git; production keeps the same
# names as Fly secrets (`fly secrets list`). Loaded by the npm scripts via
# `node --env-file-if-exists=.env`, so a clone with no .env still runs — the
# keyed lookups simply skip.

# Identifies whoever runs this code to the Wikimedia Foundation. Per-operator by
# design: there is deliberately no default, and a wrong one attributes this
# machine's traffic to someone else.
WIKIMEDIA_UA_CONTACT=you@example.com

# Smithsonian Open Access. Free from https://api.data.gov/signup/ — one form,
# key by email.
SMITHSONIAN_API_KEY=

# Free by mail; absent, the lookup skips and the page loses those cards.
# DPLA_API_KEY=
# EUROPEANA_API_KEY=
