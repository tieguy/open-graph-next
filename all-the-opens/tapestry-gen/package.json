{
  "name": "tapestry-gen",
  "private": true,
  "type": "module",
  "description": "Renders a Wikipedia article enriched with the open ecosystem's media and sources",
  "scripts": {
    "spike": "node --env-file-if-exists=.env spike.js",
    "serve": "node --env-file-if-exists=.env serve.js",
    "warm": "node --env-file-if-exists=.env warm.js",
    "deploy": "FLY_API_TOKEN=\"${FLY_DEPLOY_TOKEN_FRIENDSOF:-$FLY_API_TOKEN}\" flyctl deploy --remote-only",
    "deploy:staging": "FLY_API_TOKEN=\"${FLY_DEPLOY_TOKEN_FRIENDSOF_STAGING:-$FLY_API_TOKEN}\" flyctl deploy --config fly.staging.toml --remote-only",
    "test": "node --test 'test/*.test.js'",
    "lint": "eslint .",
    "pretest": "eslint ."
  },
  "dependencies": {
    "m3api": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  }
}
